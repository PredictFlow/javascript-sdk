{
  "name": "@predictflow/sdk",
  "version": "0.1.1",
  "type": "module",
  "description": "Official TypeScript/JavaScript SDK for PredictFlow - demand forecasting, inventory intelligence, and pricing optimization for Shopify and WooCommerce stores",
  "keywords": [
    "predictflow",
    "predictions",
    "demand-forecasting",
    "inventory-intelligence",
    "ecommerce-analytics",
    "sdk",
    "typescript",
    "api-client",
    "rest-api",
    "shopify",
    "woocommerce"
  ],
  "author": {
    "name": "PredictFlow",
    "url": "https://predictflow.co"
  },
  "license": "MIT",
  "homepage": "https://predictflow.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PredictFlow/javascript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/PredictFlow/javascript-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node -e \"const fs=require('fs'); if(fs.existsSync('dist/index.d.ts')) { ['dist/index.d.mts', 'dist/index.d.cts', 'dist/index.mjs.d.ts', 'dist/index.cjs.d.ts'].forEach(f => fs.copyFileSync('dist/index.d.ts', f)); }\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
